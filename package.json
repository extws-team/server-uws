{
	"name": "@extws/server-uws",
	"version": "0.3.0-dev",
	"description": "ExtWS server based on uWebSockets.js",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/main.js",
	"types": "dist/main.d.ts",
	"exports": {
		".": {
			"types": {
				"import": "./dist/main.d.ts",
				"require": "./dist/main.d.cts"
			},
			"import": "./dist/main.js",
			"require": "./dist/main.cjs"
		}
	},
	"engines": {
		"node": "^22 || ^23 || ^24"
	},
	"dependencies": {
		"@extws/server": "github:extws-team/server#9625673278a8a7539883bf0b6afdbdd44f9c9402",
		"uWebSockets.js": "github:uNetworking/uWebSockets.js#cfc9a40d8132a34881813cec3d5f8e3a185b3ce3"
	},
	"peerDependencies": {
		"@kirick/ip": "^0.1.1"
	},
	"devDependencies": {
		"@kirick/eslint-config": "0.1.30",
		"@types/node": "^20",
		"@types/ws": "^8.5.12",
		"eslint": "9.10.0",
		"node-fetch": "^3.3.2",
		"publint": "0.3.12",
		"tsdown": "0.12.2",
		"typescript": "5.8.3",
		"unplugin-unused": "0.5.0",
		"vitest": "3.2.3",
		"ws": "^8.18.0"
	},
	"scripts": {
		"build": "tsdown src/main.ts --clean --publint --unused --dts --format esm --format cjs",
		"check": "bun run lint && bun run build && bun run test",
		"lint": "eslint . && tsc && (cd test && tsc)",
		"test": "vitest run --no-file-parallelism"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/extws-team/server-uws.git"
	},
	"keywords": [],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/extws-team/server-uws/issues"
	},
	"homepage": "https://github.com/extws-team/server-uws#readme"
}
