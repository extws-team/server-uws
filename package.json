{
	"name": "@extws/server-uws",
	"version": "0.3.0-dev",
	"description": "ExtWS server based on uWebSockets.js",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/main.js",
	"types": "dist/main.d.ts",
	"exports": {
		".": {
			"types": {
				"import": "./dist/main.d.ts",
				"require": "./dist/main.d.cts"
			},
			"import": "./dist/main.js",
			"require": "./dist/main.cjs"
		}
	},
	"engines": {
		"node": "^22 || ^23 || ^24"
	},
	"dependencies": {
		"@extws/server": "github:extws-team/server#ff4babb8f048976d66f1cb75510494bfccb5126a",
		"uWebSockets.js": "github:uNetworking/uWebSockets.js#cfc9a40d8132a34881813cec3d5f8e3a185b3ce3"
	},
	"peerDependencies": {
		"@kirick/ip": "^0.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.1",
		"@kirick/lint": "0.2.12",
		"@types/node": "^20",
		"@types/ws": "8.18.1",
		"eslint": "9.38.0",
		"node-fetch": "3.3.2",
		"oxlint": "1.24.0",
		"publint": "0.3.15",
		"tsdown": "0.15.11",
		"typescript": "5.9.3",
		"unplugin-unused": "0.5.4",
		"valibot": "1.1.0",
		"vitest": "4.0.4",
		"ws": "8.18.1"
	},
	"scripts": {
		"build": "tsdown src/main.ts --clean --tsconfig tsconfig.main.json --publint --unused --dts --format esm --format cjs",
		"check": "bun run lint && bun run build && bun run test",
		"lint": "biome format && oxlint && eslint . && tsc -b",
		"test": "vitest run --no-file-parallelism"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/extws-team/server-uws.git"
	},
	"keywords": [],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/extws-team/server-uws/issues"
	},
	"homepage": "https://github.com/extws-team/server-uws#readme"
}
