{
	"name": "@extws/server-uws",
	"version": "0.2.0-beta.3",
	"description": "ExtWS server based on uWebSockets.js",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/esm/main.js",
	"types": "dist/esm/main.d.ts",
	"exports": {
		".": {
			"import": "./dist/esm/main.js",
			"require": "./dist/main.cjs"
		}
	},
	"engines": {
		"node": ">=16.14 <17 || >=18 <19 || >=20 <21 || >=21 <22"
	},
	"dependencies": {
		"@extws/server": "^0.2.0-beta.3",
		"uWebSockets.js": "github:uNetworking/uWebSockets.js#c10b47c350cc97c299c6b4a07a98abb628704c71"
	},
	"peerDependencies": {
		"@kirick/ip": "^0.1.1"
	},
	"devDependencies": {
		"@kirick/eslint-config": "^0.1.30",
		"@types/node": ">=16.14",
		"@types/ws": "^8.5.12",
		"eslint": "^9.8.0",
		"typescript": "5.5.4",
		"vitest": "0.34.6",
		"ws": "^8.18.0"
	},
	"scripts": {
		"build": "rm -r dist ; bun run build:ts && bun run build:cjs",
		"# build:cjs": "bunx esbuild --bundle --platform=node --format=cjs --packages=external --outfile=dist/main.cjs dist/esm/main.js",
		"build:cjs": "bun build src/main.ts --outfile=dist/main.cjs --platform=node --format=cjs --packages=external",
		"build:ts": "rm -r dist/esm ; tsc",
		"lint": "eslint . && tsc --skipLibCheck --noemit",
		"publish:npm": "bun run lint && bun run build && bun run test && npm publish",
		"test": "docker build -t test/extws-server-uws . && docker run --rm test/extws-server-uws"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/extws-team/server-uws.git"
	},
	"keywords": [],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/extws-team/server-uws/issues"
	},
	"homepage": "https://github.com/extws-team/server-uws#readme"
}
