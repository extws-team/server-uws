{
	"name": "@extws/server-uws",
	"version": "0.3.0-dev",
	"description": "ExtWS server based on uWebSockets.js",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/main.mjs",
	"types": "dist/main.d.mts",
	"exports": {
		".": {
			"types": {
				"import": "./dist/main.d.mts",
				"require": "./dist/main.d.cts"
			},
			"import": "./dist/main.mjs",
			"require": "./dist/main.cjs"
		}
	},
	"engines": {
		"node": "^22 || ^23 || ^24"
	},
	"dependencies": {
		"@extws/server": "github:extws-team/server#2626b8034c2cf77da3467cef8174d6ce7132a0b4",
		"uWebSockets.js": "uNetworking/uWebSockets.js#v20.70.0"
	},
	"peerDependencies": {
		"@kirick/ip": "^0.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@kirick/lint": "0.4.1",
		"@types/bun": "1.4.2",
		"@types/node": "^20",
		"@types/ws": "8.18.1",
		"eslint": "10.7.0",
		"node-fetch": "3.3.2",
		"oxlint": "1.74.0",
		"publint": "0.3.24",
		"tsdown": "0.23.0",
		"typescript": "6.0.3",
		"unplugin-unused": "0.6.0",
		"valibot": "1.1.0",
		"vitest": "4.0.4",
		"ws": "8.18.1"
	},
	"scripts": {
		"build": "tsdown src/main.ts --clean --publint --unused --dts --format esm --format cjs",
		"check": "lint && bun run build && bun run test",
		"test": "vitest run --no-file-parallelism"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/extws-team/server-uws.git"
	},
	"keywords": [],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/extws-team/server-uws/issues"
	},
	"homepage": "https://github.com/extws-team/server-uws#readme"
}
