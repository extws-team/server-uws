{
	"name": "@extws/server-uws",
	"version": "0.4.0-dev",
	"description": "ExtWS server based on uWebSockets.js",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"files": [
		"dist/"
	],
	"exports": {
		".": {
			"types": {
				"import": "./dist/main.d.mts",
				"require": "./dist/main.d.cts"
			},
			"import": "./dist/main.mjs",
			"require": "./dist/main.cjs"
		}
	},
	"engines": {
		"node": "^22 || ^23 || ^24"
	},
	"dependencies": {
		"@extws/server": "github:extws-team/server#6edcb183e59273e58d8c495c2902e8c9eb676331",
		"uWebSockets.js": "github:uNetworking/uWebSockets.js#cfc9a40d8132a34881813cec3d5f8e3a185b3ce3"
	},
	"peerDependencies": {
		"@kirick/ip": "^0.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@kirick/lint": "0.4.2",
		"@types/node": "^22",
		"@types/ws": "8.18.1",
		"eslint": "10.7.0",
		"node-fetch": "3.3.2",
		"oxlint": "1.74.0",
		"publint": "0.3.24",
		"tsdown": "0.23.0",
		"typescript": "6.0.3",
		"unplugin-unused": "0.6.0",
		"valibot": "1.5.0",
		"vitest": "5.0.3",
		"ws": "8.18.1"
	},
	"_devpack": {
		"@extws/server": "../server"
	},
	"scripts": {
		"build": "tsdown src/main.ts --clean --dts --format esm --format cjs --unused --publint",
		"check": "lint && bun run test && bun run build",
		"test": "vitest run --no-file-parallelism"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/extws-team/server-uws.git"
	},
	"keywords": [
		"extws",
		"websocket",
		"websocket-server",
		"uwebsockets",
		"uws",
		"realtime",
		"pubsub",
		"events"
	],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/extws-team/server-uws/issues"
	},
	"homepage": "https://github.com/extws-team/server-uws#readme"
}
